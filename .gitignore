node_modules/
dist/
coverage/

# Bun owns the lockfile (CONTRIBUTING.md); npm installs (CI tooling runs on
# Node/npm) must not leave a competing one behind
package-lock.json
scripts/.unicode-cache/
upload/

# dev-only SQLite database created by `bun index.ts` without TURSO_DATABASE_URL
server/local.db

# sandbox infra (local only)
.env
dev.log
worklog.md

# music smoke-test databases
server/local-*.db*

# playwright artifacts
test-results/
playwright-report/
vite.log

# deploy-stamped build identity (written on the box by scripts/deploy_box.py;
# never committed — the file the API reads at boot to name its build)
server/.build-id

# sandbox-only working directories (screenshots, scratch databases)
shots/
.scratch/
