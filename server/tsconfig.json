{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["bun-types"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "*.ts",
    "../src/server-notes.test.ts",
    "../src/server-handlers.test.ts",
    "../src/server-attachments.test.ts",
    "../src/server-db.test.ts"
  ],
  "exclude": ["local.db"]
}
