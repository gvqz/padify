{
  "name": "padify",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-capable notepad with a suite of mini tools, built with TypeScript and Vite",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build-share.mjs && vite build && node scripts/build-headers.mjs && node scripts/build-sw.mjs",
    "build:share": "node scripts/build-share.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:unicode": "node scripts/gen-unicode-data.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@floating-ui/dom": "^1.8.0",
    "@milkdown/kit": "^7.22.2",
    "docx": "^8.5.0",
    "jspdf": "^2.5.2",
    "katex": "^0.18.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-math": "6.0.0",
    "sweetalert2": "^11.14.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "bun-types": "^1.4.2",
    "commonmark": "^0.31.2",
    "entities": "^8.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "prettier": "^3.9.8",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
