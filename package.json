{
  "name": "padify",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-capable notepad with a suite of mini tools, built with TypeScript and Vite",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build-share.mjs && vite build && node scripts/build-headers.mjs && node scripts/build-sw.mjs",
    "build:share": "node scripts/build-share.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:unicode": "node scripts/gen-unicode-data.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@braintree/sanitize-url": "6.0.2",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@excalidraw/mermaid-to-excalidraw": "3.6.0",
    "@excalidraw/random-username": "1.1.0",
    "@lezer/highlight": "1.2.5",
    "browser-fs-access": "0.38.0",
    "canvas-roundrect-polyfill": "0.0.1",
    "clsx": "1.1.1",
    "docx": "^8.5.0",
    "es6-promise-pool": "2.5.0",
    "fuzzy": "0.1.3",
    "image-blob-reduce": "3.0.1",
    "jotai": "2.11.0",
    "jotai-scope": "0.7.2",
    "jspdf": "^2.5.2",
    "katex": "^0.18.9",
    "lodash.debounce": "4.0.8",
    "lodash.throttle": "4.1.1",
    "nanoid": "3.3.3",
    "pako": "2.0.3",
    "perfect-freehand": "1.2.0",
    "pica": "7.1.1",
    "png-chunk-text": "1.0.0",
    "png-chunks-encode": "1.0.0",
    "png-chunks-extract": "1.0.0",
    "points-on-curve": "1.0.1",
    "radix-ui": "1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "roughjs": "4.6.4",
    "tinycolor2": "1.6.0",
    "tunnel-rat": "0.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/pica": "^9.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/tinycolor2": "^1.4.6",
    "bun-types": "^1.4.2",
    "commonmark": "^0.31.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "prettier": "^3.9.8",
    "sass": "1.51.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
