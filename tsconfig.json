{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "shared", "vite.config.ts"],
  // The server contract tests import the API directly (../server/*), which
  // would drag the Bun-typed server program into this one. They are
  // typechecked by server/tsconfig.json instead, alongside the server.
  "exclude": [
    "src/server-notes.test.ts",
    "src/server-handlers.test.ts",
    "src/server-attachments.test.ts",
    "src/server-db.test.ts",
    "src/server-music-resolve.test.ts",
    "src/server-music-search.test.ts"
  ]
}
