:81 {
        handle {
                header {
                        # This edge only ever proxies the API (server/): the
                        # site itself — and its per-build content security
                        # policy — is served by Netlify from the generated
                        # dist/_headers (scripts/build-headers.mjs). A CSP
                        # has no meaning on a JSON API, so it belongs there,
                        # not here. What does belong here is the baseline for
                        # direct hits on this host: the API's own json()
                        # helper already stamps nosniff + no-store + referrer
                        # policy on every response; the edge adds frame denial
                        # and HSTS on top, which is the one header json()
                        # cannot set for itself.
                        X-Content-Type-Options nosniff
                        Referrer-Policy strict-origin-when-cross-origin
                        X-Frame-Options DENY
                        Strict-Transport-Security max-age=63072000
                }

                reverse_proxy localhost:3000 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }
}
